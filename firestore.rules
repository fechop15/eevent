rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwnDoc(userId) {
      return request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function getRol() {
      return getUserData().rol;
    }

    function isAdmin() {
      return isAuthenticated() && getRol() == 'admin';
    }

    function isOrganizador() {
      return isAuthenticated() && getRol() == 'organizador';
    }

    function canWrite() {
      return isAdmin() || isOrganizador();
    }

    match /usuarios/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isOwnDoc(userId);
    }

    match /eventos/{eventId} {
      allow read: if isAuthenticated();
      allow write: if canWrite();
    }

    match /personas/{personId} {
      allow read, write: if isAuthenticated();
    }

    match /tiposInscripcion/{tipoId} {
      allow read: if isAuthenticated();
      allow write: if canWrite();
    }

    match /inscripciones/{inscId} {
      allow read: if isAuthenticated();
      allow write: if canWrite();
      match /pagos/{pagoId} {
        allow read, write: if canWrite();
      }
    }

    match /gastos/{gastoId} {
      allow read: if isAuthenticated();
      allow write: if canWrite();
    }

    match /tareas/{tareaId} {
      allow read: if isAuthenticated();
      allow write: if canWrite();
    }

    match /espacios/{espacioId} {
      allow read: if isAuthenticated();
      allow write: if canWrite();
    }
  }
}