rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    function isOrganizador() {
      return isAuthenticated() && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'organizador';
    }

    function canWrite() {
      return isAdmin() || isOrganizador();
    }

    // Colección de usuarios del sistema
    match /usuarios/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Colección de eventos
    match /eventos/{eventId} {
      allow read: if isAuthenticated();
      allow create: if canWrite();
      allow update, delete: if canWrite();
    }

    // Colección de personas
    match /personas/{personId} {
      allow read, write: if isAuthenticated();
    }

    // Tipos de inscripción (por evento)
    match /tiposInscripcion/{tipoId} {
      allow read: if isAuthenticated();
      allow write: if canWrite();
    }

    // Inscripciones
    match /inscripciones/{inscId} {
      allow read: if isAuthenticated();
      allow create: if canWrite();
      allow update, delete: if canWrite();

      // Subcolección de pagos
      match /pagos/{pagoId} {
        allow read, write: if canWrite();
      }
    }

    // Gastos
    match /gastos/{gastoId} {
      allow read: if isAuthenticated();
      allow write: if canWrite();
    }
  }
}
